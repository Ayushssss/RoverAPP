# Local environment. `.env.example` is the committed template; anything with
# real values stays here. The root .gitignore only covers a bare `.env`, which
# would let `.env.local` through.
.env
.env.*
!.env.example

node_modules/
dist/
.vite/

# Incremental build cache. Regenerated by every `tsc -b`, so tracking it made
# a build artifact churn in commits that changed no source.
*.tsbuildinfo
