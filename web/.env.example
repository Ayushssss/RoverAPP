# Supabase — optional.
#
# The console runs fully without these: rovers live in localStorage, the relay
# carries the live path, and the History tab explains that it needs a database.
# Setting them turns on recorded telemetry and cross-device fleet sync.
#
#   1. Create a project at https://supabase.com/dashboard
#   2. Run web/supabase/migrations/0001_rover_schema.sql in the SQL editor
#   3. Copy this file to .env.local and fill in the two values below
#
# The publishable key is meant to be in the browser — row level security is what
# scopes rows, not the key. Never put a service-role key here; it bypasses RLS
# and anyone loading the page would have it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The WebSocket relay (../relay), not the socket.io one in ../server. The
# console speaks the relay's JSON protocol and authenticates with a verified
# Supabase access token; the socket.io host will not understand it.
#
# Leave unset for local development (defaults to http://localhost:8080).
VITE_RELAY_URL=https://your-relay-host
