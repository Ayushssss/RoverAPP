; AgriVerse Rover relay — systemd unit
;
; Installed by setup.sh, which substitutes __APP_DIR__ and __RUN_USER__.
; Edit this file rather than /etc/systemd/system/roverapp.service: a redeploy
; overwrites the installed copy from this one.
;
; The relay runs under systemd, not under your shell. Closing PuTTY does not
; touch it, and neither does rebooting the instance — `WantedBy=multi-user.target`
; below is what starts it again on boot.

[Unit]
Description=AgriVerse Rover relay
Documentation=https://github.com/Ayushssss/RoverAPP

; network-online is stronger than plain `network`: the latter is satisfied as
; soon as the stack is configured, which on EC2 can be before the interface has
; an address. Node would then bind and start fine, and only the outbound
; MongoDB connection would fail — a confusing failure to read at boot.
After=network-online.target
Wants=network-online.target

; ── The important line ────────────────────────────────────────
;
; `Restart=always` does not mean always. systemd applies a start rate limit —
; by default 5 starts within 10 seconds — and once a service trips it, systemd
; marks it `failed` and STOPS TRYING. No further restarts, no alert, and the
; relay stays down until somebody notices and intervenes by hand.
;
; That is the opposite of what a rate limit is usually assumed to do, and it is
; the failure this service is most likely to hit: anything that kills the
; process immediately at startup — a malformed env file, a port already taken,
; a bad build — crashes it far faster than 5-in-10 and buys a permanent outage
; instead of a retry loop.
;
; Zero disables the limit, so it retries every RestartSec forever. The cost of
; retrying a hopeless start every 5s is one log line; the cost of giving up is
; a grounded rover.
;
; This belongs in [Unit]. It lived in [Service] until systemd 229 and the old
; spelling is still accepted there for compatibility, but this newer name is
; not — in [Service] it would be ignored, silently restoring the default limit
; and with it exactly the failure the line exists to prevent.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/roverapp.env
ExecStart=/usr/bin/node dist/index.js

Restart=always
; Fast enough that nobody reaches for the console first, slow enough not to
; spin. Applies to a clean exit too, not just a crash. See the note on
; StartLimitIntervalSec in [Unit] for why this retries indefinitely.
RestartSec=5

; ── Keeping a leak local ──────────────────────────────────────
;
; The relay holds a socket per board and per viewer and forwards camera frames
; between them, which is exactly the shape of thing that leaks slowly. Without
; a ceiling, a leak takes the whole instance with it — the kernel's OOM killer
; picks by badness score, and sshd or Caddy can lose that draw, which turns a
; restartable service fault into a box you cannot log in to.
;
; With a ceiling, the relay is the only thing that dies, and Restart=always
; brings it straight back. 400M is many times the ~60M it actually uses, so
; hitting this means a genuine leak rather than a busy day.
MemoryMax=400M
MemoryAccounting=yes

; Prefer the relay over sshd if the box runs out of memory anyway. Being able
; to log in and read the journal is worth more than the relay's uptime, because
; without it you cannot fix anything.
OOMScoreAdjust=200

; ── Hardening ─────────────────────────────────────────────────
;
; This ran as root, which it never needed: it binds port 3000, and only ports
; below 1024 require privilege. Caddy owns 80 and 443 and is a separate
; service. Running as the repo's owner rather than a dedicated account is
; deliberate — a dedicated user would own the working tree, and `git pull` as
; ubuntu would then fail on every file.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=roverapp

[Install]
WantedBy=multi-user.target
