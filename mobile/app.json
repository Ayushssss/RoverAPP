{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Rover uses the local network to connect to your ESP32 rover."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "package": "agriverse.com"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/3eb1cfec-255d-4ecb-89d4-37dc762d9cff"
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "3eb1cfec-255d-4ecb-89d4-37dc762d9cff"
      }
    }
  }
}
